# Template only -- DO NOT commit a real Secret manifest with live values.
#
# Populate via your platform's secret manager in a real deployment (e.g.
# `kubectl create secret generic ... --from-literal=...`, External Secrets
# Operator, Vault CSI driver, or your cloud KMS-backed secret store) rather
# than checking a filled-in version of this file into git.
#
# Both keys are OPTIONAL: leave them blank/unset entirely to run with the
# offline MockChatModel (see infrastructure/llm.py) -- most deployments of
# this demo will not need a real provider key at all.
apiVersion: v1
kind: Secret
metadata:
  name: underwriting-secrets
  labels:
    app.kubernetes.io/name: credit-underwriting-decision-graph
type: Opaque
stringData:
  OPENAI_API_KEY: ""
  ANTHROPIC_API_KEY: ""
