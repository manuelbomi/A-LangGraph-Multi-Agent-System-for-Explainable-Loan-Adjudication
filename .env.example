# Copy this file to `.env` and fill in only what you need.
# The application runs fully offline with zero keys set -- it defaults to a
# deterministic MockChatModel (see src/underwriting/infrastructure/llm.py).
#
# NEVER commit a real `.env` file. `.gitignore` already excludes it.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=credit-underwriting-decision-graph

# --- LLM provider selection ---
# Leave both blank to use the offline MockChatModel (default, recommended for
# review/demo/CI). Setting either key switches the factory in
# src/underwriting/infrastructure/llm.py to the corresponding real provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# --- Persistence ---
# Path to the SQLite file used by LangGraph's checkpointer for durable,
# resumable graph state (human-in-the-loop escalation pauses survive process
# restarts because state is written here, not just held in memory).
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# --- Risk policy thresholds (synthetic, illustrative only) ---
DTI_BORDERLINE_LOW=0.36
DTI_BORDERLINE_HIGH=0.45
DTI_HARD_DECLINE=0.55

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
